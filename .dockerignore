# ---------------------------------------------------------------------------
# Appliance image bloat — keep the build context (and the baked layer) lean.
# These are never needed inside the runtime image: the LLM model is mounted
# from the host on the llama service, build artifacts/fixtures/dev tooling have
# no runtime role, and the dev sqlite DB must never be baked in.
# ---------------------------------------------------------------------------
/models
/dist
/test_data
/shots
/sessions
/tinker
/.playwright-mcp
/.claude
# NOTE: /agent is intentionally NOT ignored — it is the runtime Mil knowledge
# base (config('ai.system_prompt_path') = base_path('agent')), read by
# KnowledgeLoader on every AI query. Excluding it ships an image with no KB, so
# app-specific (/sosvault) answers silently degrade to generic model output.
/tests
/module_builder
/docs
/scripts
/.github
/database/schema
# Glob (matches .gitignore) so the dev DB, its -shm/-wal, AND every dated
# backup (database.sqlite.2026-05-05, …) are kept out of the build context —
# never bake stale dev data into the image.
/database/database.sqlite*
/storage/app/geoip.mmdb
/sysadmin/redirect
/sysadmin/weylandQuest.sh
/HANDOFF.md
/CLAUDE.md
/boost.json
# Host-side / dev-only files with no role inside the runtime image: compose
# runs on the HOST (the deb ships docker-compose.appliance.yml via build.sh, not
# the image); .env.testing is test-only (.env is bind-mounted at runtime); the
# rest are editor / MCP / doc cruft.
/docker-compose.yml
/docker-compose.appliance.yml
/.env.testing
/.editorconfig
/.mcp.json
/.cramb
/README-YOUTUBE-API-KEYS.md
# Build/VCS metadata with no runtime role — the Dockerfile is read by the
# builder from the context root, never COPYed into /var/www/site.
/Dockerfile
/.gitattributes
/.gitignore
/.dockerignore

#/storage/*.key
!.gitignore
!.gitkeep
!.gitmodules

!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
!/storage/framework/testing/disks/local/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/logs/.gitkeep
!/storage/app/dashboard/tmp/.gitkeep
!/storage/app/public/.gitkeep
!/storage/api-docs/.gitkeep
