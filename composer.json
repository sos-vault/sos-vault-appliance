{
    "name": "jlrueda/sos-vault",
    "description": "sos report analysis tools",
    "keywords": [
        "framework",
        "laravel",
        "SaaS",
        "Starter Kit"
    ],
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-exif": "*",
        "ext-gd": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-google-analytics": "^3.0",
        "calebporzio/sushi": "^2.5",
        "chillerlan/php-authenticator": "^5.4",
        "codeat3/blade-phosphor-icons": ">=2.3",
        "devdojo/app": ">=0.11",
        "devdojo/themes": ">=0.0.11",
        "echolabsdev/prism": "*",
        "filament/filament": "^4.1.2",
        "gehrisandro/tailwind-merge-laravel": ">=1.3",
        "geoip2/geoip2": "~3.0",
        "guzzlehttp/guzzle": ">=7.9.2",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "lab404/laravel-impersonate": ">=1.7.7",
        "laravel/folio": ">=1.1.10",
        "laravel/framework": ">=12.2",
        "laravel/tinker": ">=2.10.1",
        "laravel/ui": ">=4.6.1",
        "livewire/livewire": ">=3.6.2",
        "livewire/volt": "^1.7",
        "phiki/phiki": "^2.2",
        "predis/predis": "^3.4",
        "ralphjsmit/livewire-urls": ">=1.5",
        "socialiteproviders/facebook": "^4.1",
        "socialiteproviders/github": "^4.1",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/manager": "^4.9",
        "spatie/laravel-permission": ">=6.16",
        "spatie/laravel-translatable": "*",
        "stripe/stripe-php": ">=16.6",
        "torann/geoip": "^3.0",
        "tymon/jwt-auth": "@dev",
        "ublabs/blade-simple-icons": "^0.171.0"
    },
    "require-dev": {
        "alebatistella/duskapiconf": ">=1.2.5",
        "fakerphp/faker": ">=1.24.1",
        "laravel/boost": "^2.3",
        "laravel/dusk": ">=8.3.2",
        "laravel/pail": ">=1.2.2",
        "laravel/pint": "^1.21.1",
        "mockery/mockery": ">=1.6.12",
        "nunomaduro/collision": ">=8.6.1",
        "pestphp/pest": ">=3.7.4",
        "pestphp/pest-plugin-laravel": ">=3.1",
        "phpunit/phpunit": ">=11.5.3",
        "spatie/laravel-ignition": ">=2.9.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Wave\\": "wave/src/"
        },
        "files": [
            "app/Helpers/sosVaultHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "Wave\\WaveServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover",
            "@php -r \"chdir('public'); is_link('storage') && unlink('storage'); is_link('storage') || file_exists('storage') || symlink('../storage/app/public', 'storage');\"",
            "@php artisan filament:upgrade",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
